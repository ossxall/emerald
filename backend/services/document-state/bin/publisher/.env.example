PULSAR_URL=pulsar://emerald-broker:6650
PULSAR_RECONNECT_DELAY_SECS=5
PULSAR_MAX_RETRIES=10
PULSAR_BATCH_SIZE=100
TOPIC_LIST=persistent://public/default/document.processed
BATCH_SIZE=50
POLL_INTERVAL=5

RUST_LOG=info
DATABASE_URL=postgres://postgres:password@emerald-postgres:5432/document_state
PG_MAX_CONNECTIONS=10
PG_ACQUIRE_TIMEOUT_SECS=30